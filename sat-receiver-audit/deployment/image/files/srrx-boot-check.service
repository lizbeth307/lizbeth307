[Unit]
Description=SR-RX boot self-check before boot-complete.target (A/B blessing)
Documentation=file:/opt/srrx/deployment/image/README.md
# Route A: systemd-bless-boot marks the entry good only after boot-complete.target, and this
# unit is RequiredBy= it; a failure leaves the tries counter running down (STACK.md:843).
# boot-complete.target is queued only while boot counting is in effect (systemd-bless-boot
# pulls it); WantedBy=multi-user.target runs the same check on every boot, blessed or not.
DefaultDependencies=no
Wants=srrx-radio-off.service
After=local-fs.target srrx-radio-off.service systemd-modules-load.service
Before=boot-complete.target shutdown.target
Conflicts=shutdown.target
RequiresMountsFor=/opt/srrx /boot/efi /data

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -I -B /opt/srrx/deployment/image/bootchain.py boot-check
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryMax=128M

[Install]
RequiredBy=boot-complete.target
WantedBy=multi-user.target
