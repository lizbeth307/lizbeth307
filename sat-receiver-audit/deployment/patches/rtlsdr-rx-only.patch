 	*out_dev = dev;
 
 	return 0;
@@ -1676,6 +1678,8 @@
 #endif
 		}
 
+		/* SRRX_RX_ONLY: best-effort OFF while the device is still present. */
+		rtlsdr_set_bias_tee_gpio(dev, 0, 0);
 		rtlsdr_deinit_baseband(dev);
