(version 1)
# GENERATED by pcb/stackup.py; do not edit (rerun: python pcb/stackup.py). JLC04161H-7628 4 layers 1.6 mm, outer 1 oz / inner 0.5 oz.
# Fab floors: https://jlcpcb.com/capabilities/pcb-capabilities (read 2026-11-07); they belong in Board Setup (absolute minimums, see netclasses.json
# fab_floor.board_setup_floor_4l). The rules below are the project defaults (floor + margin) and the net classes.
# Values are MODEL/design rules: DRC 0 proves rule compliance only; bench gates stay OPEN.
# KiCad: later rules take precedence; once a matching rule is found no further rules are checked.

# JLC: track/track 0.09mm, pad/track 0.1mm, SMD pad/pad 0.15mm (https://jlcpcb.com/capabilities/pcb-capabilities, 2026-11-07)
(rule "project default clearance"
  (constraint clearance (min 0.15mm))
)

# JLC floor 0.09mm (https://jlcpcb.com/capabilities/pcb-capabilities, 2026-11-07)
(rule "project default track"
  (constraint track_width (min 0.15mm) (opt 0.15mm))
)

# JLC floor via 0.15mm/0.25mm, via hole to track 0.2mm, inner via hole to copper 0.2mm (https://jlcpcb.com/capabilities/pcb-capabilities, 2026-11-07)
(rule "project via"
  (constraint via_diameter (min 0.6mm) (opt 0.6mm))
  (constraint hole_size (min 0.3mm) (opt 0.3mm))
  (constraint annular_width (min 0.15mm))
  (constraint hole_clearance (min 0.25mm))
  (condition "A.Type == 'Via'")
)

# JLC: pad hole-to-hole 0.45mm, via hole-to-hole 0.2mm (https://jlcpcb.com/capabilities/pcb-capabilities, 2026-11-07)
(rule "project hole to hole"
  (constraint hole_to_hole (min 0.5mm))
)

# JLC: copper to routed edge 0.2mm (https://jlcpcb.com/capabilities/pcb-capabilities, 2026-11-07)
(rule "project board edge"
  (constraint edge_clearance (min 0.3mm))
)

# JLC: silkscreen text >= 1mm, line >= 0.15mm (https://jlcpcb.com/capabilities/pcb-capabilities, 2026-11-07)
(rule "project silkscreen text"
  (constraint text_height (min 1mm))
  (constraint text_thickness (min 0.15mm))
  (condition "A.existsOnLayer('F.SilkS') || A.existsOnLayer('B.SilkS')")
)

# JLC: PTH to track 0.28mm min / 0.35mm recommended, inner PTH hole to copper 0.3mm, PTH drill max 6.3mm (https://jlcpcb.com/capabilities/pcb-capabilities, 2026-11-07)
# JLC PTH annular ring multilayer 1 oz: absolute minimum 0.15mm, recommended 0.2mm (https://jlcpcb.com/capabilities/pcb-capabilities, 2026-11-07); the rule is the minimum (library THT footprints), pcb/check_boards.py uses the same floor
(rule "project PTH pad hole"
  (constraint hole_size (min 0.3mm) (max 6.3mm))
  (constraint hole_clearance (min 0.35mm))
  (constraint annular_width (min 0.15mm))
  (condition "A.Type == 'Pad' && A.isPlated()")
)

# JLC: NPTH min 0.5mm, NPTH to track 0.2mm (https://jlcpcb.com/capabilities/pcb-capabilities, 2026-11-07)
(rule "JLC NPTH hole"
  (constraint hole_size (min 0.5mm) (max 6.3mm))
  (constraint hole_clearance (min 0.3mm))
  (condition "A.Pad_Type == 'NPTH, mechanical'")
)

# contract hole_d 3.2 / hole_keepout_d 7.0 (mechanical/generated/contract/boards.json): (7.0 - 3.2) / 2 from the hole edge
(rule "mounting hole 3.2 keepout"
  (constraint hole_clearance (min 1.9mm))
  (condition "A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X >= 3.15mm && A.Hole_Size_X <= 3.25mm")
)

# contract hole_d 2.7 / hole_keepout_d 6.0 (mechanical/generated/contract/boards.json): (6.0 - 2.7) / 2 from the hole edge
(rule "mounting hole 2.7 keepout"
  (constraint hole_clearance (min 1.65mm))
  (condition "A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X >= 2.65mm && A.Hole_Size_X <= 2.75mm")
)

# BOND-RF exception: the single GND/CHASSIS bond hole (footprint reference HB*) is plated and netted (CHASSIS);
# copper of its own net may enter the keepout, other nets keep the 7.0 mm circle (boards.json RF mount)
(rule "BOND-RF hole keepout"
  (constraint hole_clearance (min 1.9mm))
  (condition "A.memberOfFootprint('HB*')")
)

# PWR1A: capacity 1.0 A at +10 degC / 1.0 A at +20 degC (TPS2553 limits <=0.989 A (VBUS_HFP) and eFuse limits <=1 A);
# IPC-2221 1 oz outer 0.3004 mm -> class width 0.35 mm (netclasses.json, MODEL)
# pour necks (zones) are measured by pcb/check_boards.py; no KiCad connection_width rule (fine-pitch pad entries)
(rule "PWR1A outer width"
  (layer outer)
  (constraint track_width (min 0.35mm) (opt 0.35mm))
  (condition "A.hasNetclass('PWR1A')")
)

# PWR1A on 0.5 oz inner copper (IPC-2221 internal k 0.024), MODEL
(rule "PWR1A inner width"
  (layer inner)
  (constraint track_width (min 1.8mm) (opt 1.8mm))
  (condition "A.hasNetclass('PWR1A')")
)

# PWR2A: capacity 2.0 A at +10 degC / 2.2 A at +20 degC (eFuse U203 limit 1.80-2.20 A (LIME3V3));
# IPC-2221 1 oz outer 0.7814 mm -> class width 0.8 mm (netclasses.json, MODEL)
# pour necks (zones) are measured by pcb/check_boards.py; no KiCad connection_width rule (fine-pitch pad entries)
(rule "PWR2A outer width"
  (layer outer)
  (constraint track_width (min 0.8mm) (opt 0.8mm))
  (condition "A.hasNetclass('PWR2A')")
)

# PWR2A on 0.5 oz inner copper (IPC-2221 internal k 0.024), MODEL
(rule "PWR2A inner width"
  (layer inner)
  (constraint track_width (min 4.7mm) (opt 4.7mm))
  (condition "A.hasNetclass('PWR2A')")
)

# PWR3A: capacity 3.2 A at +10 degC / 5.0 A at +20 degC (LAB5 budget 3.2 A (E1-05) and F103 5 A (E1_SERVICE_P));
# IPC-2221 1 oz outer 1.8159 mm -> class width 1.85 mm (netclasses.json, MODEL)
# DRC floor is the L1+L4 split width 1.05 mm per layer; pcb/check_boards.py enforces 1.85 mm unless the net is split on both outer layers
# pour necks (zones) are measured by pcb/check_boards.py; no KiCad connection_width rule (fine-pitch pad entries)
(rule "PWR3A outer width"
  (layer outer)
  (constraint track_width (min 1.05mm) (opt 1.85mm))
  (condition "A.hasNetclass('PWR3A')")
)

# PWR3A: inner 0.5 oz copper is not counted as a current path, so no PWR3A track on In1/In2 (a thin inner
# track would carry the current in series); inner pours stay allowed and uncounted; PWR_BRANCH* rule areas excepted
(rule "PWR3A no inner tracks"
  (layer inner)
  (constraint disallow track)
  (condition "A.hasNetclass('PWR3A') && !A.intersectsArea('PWR_BRANCH*')")
)

# BATT: capacity 4.6 A at +10 degC / 7.5 A at +20 degC (battery path 4.6 A model and F101 7.5 A);
# IPC-2221 1 oz outer 3.1766 mm -> class width 3.2 mm (netclasses.json, MODEL)
# DRC floor is the L1+L4 split width 1.85 mm per layer; pcb/check_boards.py enforces 3.2 mm unless the net is split on both outer layers
# pour necks (zones) are measured by pcb/check_boards.py; no KiCad connection_width rule (fine-pitch pad entries)
(rule "BATT outer width"
  (layer outer)
  (constraint track_width (min 1.85mm) (opt 3.2mm))
  (condition "A.hasNetclass('BATT')")
)

# BATT: inner 0.5 oz copper is not counted as a current path, so no BATT track on In1/In2 (a thin inner
# track would carry the current in series); inner pours stay allowed and uncounted; PWR_BRANCH* rule areas excepted
(rule "BATT no inner tracks"
  (layer inner)
  (constraint disallow track)
  (condition "A.hasNetclass('BATT') && !A.intersectsArea('PWR_BRANCH*')")
)

# project rule: low-current branches of power nets (Kelvin sense lines, decoupling stubs) inside rule areas named PWR_BRANCH*
# take the project default track 0.15mm (JLC floor 0.09mm, https://jlcpcb.com/capabilities/pcb-capabilities, 2026-11-07); each is listed in the board
# spec branch_exempt {ref: {max_mm, min_width_mm, reason}} and bounded by pcb/check_boards.py
(rule "power branch area"
  (constraint track_width (min 0.15mm))
  (condition "(A.hasNetclass('PWR1A') || A.hasNetclass('PWR2A') || A.hasNetclass('PWR3A') || A.hasNetclass('BATT')) && A.intersectsArea('PWR_BRANCH*')")
)

# CBCPW w 0.36 / s 0.2 over L2 at h 0.2104, er 4.4: 51.24 ohm closed form (MODEL; https://jlcpcb.com/impedance, 2026-11-07)
# L2 solid under RF50 (3h band) and the fence pitch are checked by pcb/check_boards.py, not by KiCad
(rule "RF50 CPWG on L1"
  (layer "F.Cu")
  (constraint track_width (min 0.355mm) (opt 0.36mm) (max 0.365mm))
  (constraint clearance (min 0.2mm))
  (condition "A.hasNetclass('RF50')")
)

# project rule: RF50 tapers into IC pins inside rule areas named RF_TAPER* may narrow to 0.15mm
# (JLC floor 0.09mm, https://jlcpcb.com/capabilities/pcb-capabilities, 2026-11-07); clearance stays 0.2mm; each taper is listed in the board spec
# rf50_taper {ref: {max_len_mm, min_width_mm, reason}} and bounded by pcb/check_boards.py
(rule "RF50 taper area"
  (layer "F.Cu")
  (constraint track_width (min 0.15mm) (max 0.365mm))
  (condition "A.hasNetclass('RF50') && A.intersectsArea('RF_TAPER*')")
)

# RF50 lines stay on F.Cu over the solid In1.Cu GND (layer plan, build/15)
(rule "RF50 only on L1"
  (layer inner)
  (constraint disallow track via)
  (condition "A.hasNetclass('RF50')")
)

(rule "RF50 not on L4"
  (layer "B.Cu")
  (constraint disallow track)
  (condition "A.hasNetclass('RF50')")
)

# DCTAP +/-30 V envelope (constraints.json DC-04). Clearance 0.3 mm: project choice, not IPC-verified;
# IPC-2221B Table 6-1 not readable (https://shop.ipc.org/ipc-2221/ipc-2221-standard-only, 2026-11-07): TBD in netclasses.json
(rule "DCTAP width and clearance"
  (constraint track_width (min 0.2mm) (opt 0.2mm))
  (constraint clearance (min 0.3mm))
  (condition "A.hasNetclass('DCTAP') || B.hasNetclass('DCTAP')")
)
