[Unit]
Description=SR-RX local touch console
# User unit of the touch session (srrx-ui): the labwc autostart, or cage in safe mode, starts it with
# `systemctl --user start --wait` once it is enabled (deployment/system/session). Without the venv the
# start is skipped, not failed. Restart=no: when the console stops, lab-session counts a session failure.
ConditionPathExists=/opt/srrx/venv/bin/python3
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/opt/srrx
Environment=PYTHONPATH=/opt/srrx/software
ExecStart=/usr/bin/env /opt/srrx/venv/bin/python3 -m srrx.hmi --socket /run/srrx/control.sock --fullscreen
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
