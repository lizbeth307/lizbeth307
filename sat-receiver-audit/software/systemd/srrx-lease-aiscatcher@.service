[Unit]
Description=SR-RX exclusive engine lease: AIS-catcher on receiver %i (receive-only, localhost only)
# Started and stopped only by labd (operation engine_lease, srrx.engine_leases) through the polkit
# rule 60-srrx-engine-lease.rules. No [Install]: never enabled and never wanted by another unit.
# The instance is the udev alias /dev/lab/%i of one receiver (rtla, rtlb or hfplus; deploy.udev_rules).
AssertPathExists=/dev/lab/%i
# No lease outlives the labd that granted it: a stop, a crash or a restart of srrx.service stops it.
BindsTo=srrx.service
After=srrx.service
CollectMode=inactive-or-failed

[Service]
Type=simple
User=lab
Group=lab
WorkingDirectory=/
# STACK.md C7 lease mode 2: DeviceAllow= stat()s the alias at start; a missing node adds no rule,
# so DevicePolicy=closed leaves only the pseudo devices and read-only RTC (ProtectClock=yes implies
# DeviceAllow=char-rtc r). Without cgroup BPF systemd starts the unit with no device ACL and no IP
# filter at all (fail open): CONFIG_CGROUP_BPF=y and RX-12-runtime come before any lease is used.
DevicePolicy=closed
DeviceAllow=/dev/lab/%i rw
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/data
# 2750 lab:labd, created by usr/lib/tmpfiles.d/srrx.conf (deployment/system/system_files.py).
ReadWritePaths=/data/products/aiscatcher-%i
# Engine-private state lives only as long as the lease.
RuntimeDirectory=srrx-lease-aiscatcher-%i
RuntimeDirectoryMode=0700
Environment=HOME=%t/srrx-lease-aiscatcher-%i
UMask=0027
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
KeyringMode=private
SystemCallArchitectures=native
# build/07 §21 OOM order: an engine lease ranks with OpenWebRX+ (500), before labd and labrx.
OOMScoreAdjust=500
# labd stops the lease with the operator lease; these bound a lease labd failed to stop.
RuntimeMaxSec=12h
TimeoutStartSec=30s
TimeoutStopSec=10s
Restart=no
# Arguments (W2 SW-AIS, ais-catcher 0.70+lab1): srrx.ais_filter prepare writes the receiver
# selection (-d <serial from /etc/srrx/devices.json> -s <rate>) as an @response file and creates
# the FIFO, both 0600 here. AIS-catcher writes JSON only into that FIFO (-o 0: nothing on stdout or
# in the journal), never with -X, -N, -H, -P, -u, -S, -Q, -D or a bias setting (STACK.md:882,
# selftest RX-12-ais). srrx.ais_filter serve (same user and sandbox; it stays in this unit's cgroup)
# publishes /data/products/aiscatcher-%i/vessels.json: a vessel only after a static report with a
# known ship type other than 35, a late type 35 deletes it (STACK.md:599). The /usr/bin/env prefix
# stays: the lab guest verifies every staged unit without the +lab engine packages
# (guest_smoke.verify_units).
Environment=PYTHONPATH=/opt/srrx/software PYTHONDONTWRITEBYTECODE=1 LC_ALL=C.UTF-8
ExecStartPre=/usr/bin/python3 -P -s -B -m srrx.ais_filter prepare --receiver %i --devices /etc/srrx/devices.json --runtime %t/srrx-lease-aiscatcher-%i
ExecStart=/usr/bin/env AIS-catcher @%t/srrx-lease-aiscatcher-%i/receiver.args -o 0 -f %t/srrx-lease-aiscatcher-%i/ais.fifo MSGFORMAT JSON_FULL
ExecStartPost=/usr/bin/python3 -P -s -B -m srrx.ais_filter serve --receiver %i --fifo %t/srrx-lease-aiscatcher-%i/ais.fifo --output /data/products/aiscatcher-%i --detach
