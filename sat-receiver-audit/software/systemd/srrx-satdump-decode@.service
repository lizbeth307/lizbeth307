[Unit]
Description=SR-RX SatDump file decode of LRPT baseband %i (no network, no device)
# Generated text: srrx.satdump_pass.unit_text("decode"); edit the generator, then this file.
# Started only by labd (srrx.baseband_scheduler) through 60-srrx-satdump.rules. No install section:
# never enabled and never wanted by another unit. The instance is the recording id; it selects
# the bound paths below and nothing else, and srrx.satdump_unit re-validates the job.
CollectMode=inactive-or-failed
RequiresMountsFor=/data

[Service]
Type=oneshot
User=srrx-satdump
Group=srrx-satdump
UMask=0007
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryMax=1536M
MemorySwapMax=0
TasksMax=64
CPUAffinity=0-3
Nice=10
TemporaryFileSystem=/data:ro
WorkingDirectory=/var/lib/srrx-satdump/empty
RuntimeDirectory=srrx-satdump-%i
RuntimeDirectoryMode=0700
Environment=HOME=/run/srrx-satdump-%i
Environment=LC_ALL=C.UTF-8
BindPaths=/data/products/satdump/.satdump-%i
SupplementaryGroups=srrx-bb
BindReadOnlyPaths=/data/raw/baseband-lrpt/%i.sigmf-data
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
LoadCredential=job:/run/srrx/satdump/%i/job.json
TimeoutStartSec=1920
Environment=PYTHONPATH=/opt/srrx/software PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -P -s -B -m srrx.satdump_unit decode %i
