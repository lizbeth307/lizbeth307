[Unit]
Description=SR-RX PPS gate (chronyc selectopts PPS for labd only)
After=chrony.service

[Service]
Type=simple
User=_chrony
Group=_chrony
WorkingDirectory=/opt/srrx
Environment=PYTHONPATH=/opt/srrx/software PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -B -m srrx.timegate --socket /run/srrx-timegate/timegate.sock --peer-user labd
Restart=on-failure
RestartSec=2
TimeoutStopSec=3
RuntimeDirectory=srrx-timegate
RuntimeDirectoryMode=0755
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-/run/chrony
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
LockPersonality=yes
MemoryMax=48M
TasksMax=4

[Install]
WantedBy=multi-user.target
