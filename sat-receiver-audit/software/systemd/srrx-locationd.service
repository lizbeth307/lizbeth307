[Unit]
Description=SR-RX location service (the one GNSS position reader, local AF_UNIX snapshots only)
After=local-fs.target
ConditionPathExists=/etc/srrx/devices.env

[Service]
Type=simple
User=srrx-loc
Group=srrx-loc
WorkingDirectory=/opt/srrx
Environment=PYTHONPATH=/opt/srrx/software PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/srrx/devices.env
ExecStart=/usr/bin/python3 -B -m srrx.locationd --gnss ${SRRX_GNSS} --socket /run/srrx-loc/location.sock --control-user labd
Restart=on-failure
RestartSec=5
TimeoutStopSec=3
RuntimeDirectory=srrx-loc
RuntimeDirectoryMode=0755
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
LockPersonality=yes
MemoryMax=64M
TasksMax=4

[Install]
WantedBy=multi-user.target
