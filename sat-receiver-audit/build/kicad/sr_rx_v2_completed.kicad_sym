(property "Value" "35SVPF22M 22 µF 35 V ±20% OS-CON" (at 0 -2.54 0) (effects (font (size 1.016 1.016)) ))
(property "Footprint" "" (at 0 0 0) (effects (font (size 1.016 1.016)) (hide yes)))
