(property "Value" "2N7002,215" (at 0 -2.54 0) (effects (font (size 1.016 1.016)) ))
(property "Footprint" "Package_TO_SOT_SMD:SOT-23" (at 0 0 0) (effects (font (size 1.016 1.016)) (hide yes)))
(property "Datasheet" "https://assets.nexperia.com/documents/data-sheet/2N7002.pdf; Microchip DS20001952D table1-2" (at 0 0 0) (effects (font (size 1.016 1.016)) (hide yes)))
(property "Description" "Open-drain pull-down for the shared active-low reset of all three internal MCP23017 expanders. Gate is driven only by Pico GP17. | design | Physical SOT23 pins:1gate,2source,3drain. No Pico3V3 DC connection to Q6A3V3: the MOS gate is insulated. Drain pullups are only to switched3V3_Q6A.; GP17 high or highimpedance while Pico3V3 is present asserts RESET low via R395. Working firmware must actively hold GP17 low to release reset. R394100k gate-source pulldown turns Q306 off only when Pico supply is absent; complete loss ofPico power is not an independently covered fault.; The three existing10k reset pullups remain in parallel, equivalent3.33k. Sink current is about0.99mA at3.3V. Scope verification must show RESET_N<0.2VDD when asserted and>0.8VDD when released." (at 0 0 0) (effects (font (size 1.016 1.016)) (hide yes)))
