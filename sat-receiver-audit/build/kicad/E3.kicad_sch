(symbol "sr_rx_v2_completed:C_U305"  (pin_names (offset 0.508)) (exclude_from_sim no) (in_bom yes) (on_board yes)
(property "Reference" "U305" (at 0 38.1 0) (effects (font (size 1.016 1.016)) ))
(property "Value" "Raspberry Pi Pico SC0915" (at 0 35.56 0) (effects (font (size 1.016 1.016)) ))
(property "Footprint" "" (at 0 0 0) (effects (font (size 1.016 1.016)) (hide yes)))
(property "Datasheet" "https://datasheets.raspberrypi.com/pico/Pico-R3-A4-Pinout.pdf" (at 0 0 0) (effects (font (size 1.016 1.016)) (hide yes)))
(property "Description" "Factory Pico RP2040 module with physical pins 1-40 plus three named SWD pads. Factory SMPS, flash, clock and bypass capacitors retained. | module | VSYS receives LAB5 through a Schottky diode. Module VBUS is reserved for USB programming or fallback H1. Never bridge VBUS to LAB5; connect USB only with the main switch on or LAB5 isolated.; Remove factory R7 before fitting the external 200 ohm ADC_VREF feed and LM4040C30. Battery ADC divider belongs to E1. ADC inputs must remain below the 3.0V reference.; Before Q6A 3V3 is present, put UART TX, SAFE_BOOT and service outputs in high impedance. This schematic relies on verified firmware sequencing; it does not claim hardware isolation.; All26 exposed GPIOs are assigned: GP17 physical22 now drives the MCP hardware-reset actuator, not brightness. No free Pico GPIO remains. GP23/24/25/29 are module internal and allthree external ADCs are assigned.; Required firmware behavior, not implemented firmware: assert GP17 high early at boot; maintain or assert it on missing/invalid UART heartbeat or unsafe shutdown; hold until an explicit qualified recovery/re-arm sequence. Program safe OLAT=0 and IOCON.ODR/MIRROR before re-enabling outputs and interrupts.; A sustained low on common MCP RESET makes allinternal expander output drivers high-impedance. Recipient pulldowns then disable their power branches, select HMC00 and turn relays off. It also resets allMCP fault history, which software must log before intentional reset where possible.; Brightness remains DDC/CI or a separately documented future KEY interface through an available MCP GPIO. GP17 is committed to watchdog reset." (at 0 0 0) (effects (font (size 1.016 1.016)) (hide yes)))
(symbol "C_U305_0_1" (rectangle (start -25.4 29.21) (end 25.4 -29.21) (stroke (width 0.254) (type default)) (fill (type background))))
