      )
      (hide yes)
    )
    (property "Description" "Waveshare LC76G GNSS Module (SKU 24370), Quectel LC76G + RT9193-33 LDO. Header P1 per Waveshare module schematic: 1 VCC, 2 GND, 3 TXD, 4 RXD, 5 1PPS, 6 RESET (to LC76G RESET_N via R4 0R, active low), 7 SDA, 8 SCL; antenna IPEX GPS1: pin 2 DATA (RF_IN, VCC_RF bias via R5 10R + L1 68nH) drawn as RF, pins 1/3/4 GND drawn as RFG. Wiki: VCC 3.3-5 V; STACK v2 5.2: feed 5 V only. P1 pin 0 (GND, shown in the schematic) is not drawn."
      (at 0 -10.16 0)
      (effects
        (font (size 1.27 1.27))
      )
      (hide yes)
    )
    (property "ki_keywords" "GNSS GPS LC76G Waveshare module UART PPS"
