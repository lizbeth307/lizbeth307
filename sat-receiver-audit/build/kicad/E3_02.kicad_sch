(property "Reference" "R397" (at 0 0 0) (effects (font (size 1.016 1.016)) ))
(property "Value" "140k 1%" (at 0 -2.54 0) (effects (font (size 1.016 1.016)) ))
(property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 0 0 0) (effects (font (size 1.016 1.016)) (hide yes)))
(property "Datasheet" "https://www.ti.com/lit/ds/symlink/tps2553.pdf" (at 0 0 0) (effects (font (size 1.016 1.016)) (hide yes)))
(property "Description" " | design | RILIM of U316: 140k +-1 % gives IOS 0.165-0.223 A (SLVS841G eq. 1, IOSmax = 22980/R^0.94 at 138.6k; eq. 3, IOSmin = 25230/R^1.016 at 141.4k; recommended 15-232k, re-read 2026-11-22): above the Pico VSYS load model with the F302 and U316 series drops (0.146-0.151 A at LAB5 5.02 V, 0.154-0.159 A at LAB5 4.80 V; margin +3.5 % in the worst corner without the copper, +2.3 % with the 0.287 ohm of the 79.8 mm E3_PICO_VSYS copper from D301.1 to U305.39, review RV-CTRL6-E2-2; the load reaches IOSmin when F302 reaches about 1.52 ohm in circuit at LAB5 4.80 V, 2.86 ohm at 5.02 V, and Bourns gives Rmin/R1max at 23 C only; MODEL) and within the 0.224 A of the 0.15 mm inner E3_PICO_VSYS copper at +20 C (+19.8 C at 0.223 A, 0.0152 mm foil; MODEL). 140k instead of the 150k of the first W2 CTRL-6 commit (IOSmin 0.154 A: margin -3 % at LAB5 4.80 V; review RV-CTRL6-E-1, build/15 row 'Запас VSYS Pico з F302: RILIM 140 кОм (W2 CTRL-6)'). Bench gate: Pico VSYS voltage and current at 70 C ambient with LAB5 4.80 V (OPEN)." (at 0 0 0) (effects (font (size 1.016 1.016)) (hide yes)))
(symbol "C_R397_0_1" (rectangle (start -1.016 2.54) (end 1.016 -2.54) (stroke (width 0.254) (type default)) (fill (type none))))
(symbol "C_R397_1_1" (pin passive line (at 0 5.08 270) (length 2.54) (name "1" (effects (font (size 0.889 0.889)) )) (number "1" (effects (font (size 0.889 0.889)) ))) (pin passive line (at 0 -5.08 90) (length 2.54) (name "2" (effects (font (size 0.889 0.889)) )) (number "2" (effects (font (size 0.889 0.889)) )))))
