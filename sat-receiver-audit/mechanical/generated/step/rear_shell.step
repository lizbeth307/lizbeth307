#17954 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#17955 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#17956 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.0000001),#17953,
  'distance_accuracy_value','confusion accuracy');
#17957 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
ENDSEC;
END-ISO-10303-21;
