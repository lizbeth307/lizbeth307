# Preserve native KiCad plot bytes, including whitespace in SVG style records.
build/kicad/svg/*.svg -whitespace
build/kicad/pcb-preparation/*.svg -whitespace
# Raw native command logs retain the tool's final blank lines.
build/kicad/pcb-preparation/*-command.log -whitespace
build/kicad/pcb-prototype/*.svg -whitespace
build/kicad/pcb-prototype/*-command.log -whitespace
# Unified diffs retain exact upstream context, including blank context lines.
# -text: no EOL conversion, so CRLF checkouts keep both byte-exact.
deployment/patches/*.patch -text -whitespace
# Primary upstream source fixtures are byte-for-byte patch inputs.
deployment/upstream-fixtures/** -text -whitespace
# Raw serial console captures from the ARM64 guest keep the console's CR bytes.
verification/linux-lab/console.log -whitespace
verification/linux-attempts/*/console.log -whitespace
